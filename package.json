{
  "name": "ssb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "rm -rf node_modules/@ssb/db && mkdir -p node_modules/@ssb/db && cp -R packages/db/package.json packages/db/tsconfig.json packages/db/src node_modules/@ssb/db/",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "u": "bunx npm-check-updates -u && bun install",
    "lint": "eslint",
    "seed": "supabase db reset",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "@opennextjs/cloudflare": "^1.19.6",
    "@ssb/db": "file:./packages/db",
    "@supabase/supabase-js": "^2.97.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.1",
    "embla-carousel-react": "^8.6.0",
    "html5-qrcode": "^2.3.8",
    "iron-session": "^8.0.4",
    "jose": "^6.1.3",
    "motion": "^12.34.2",
    "next": "^16.2.6",
    "passkit-generator": "^3.5.7",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "wrangler": "^4.86.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/canvas-confetti": "^1.9.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.4",
    "opentype.js": "^1.3.4",
    "prettier": "3.7.4",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}