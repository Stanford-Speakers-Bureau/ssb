{
  "name": "ssb-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "rm -rf node_modules/@ssb/db && mkdir -p node_modules/@ssb/db && cp -R packages/db/package.json packages/db/tsconfig.json packages/db/src node_modules/@ssb/db/",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "seed": "bun run seed.ts",
    "u": "bunx npm-check-updates -u && bun install",
    "lint": "eslint",
    "prettier": "prettier --write .",
    "test": "bun test",
    "test:unit": "bun test app packages",
    "test:integration": "TEST_INTEGRATION=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres bun test tests/integration",
    "test:e2e": "bunx playwright test --project=chromium",
    "test:a11y": "bunx playwright test --project=a11y",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:all": "bun run test && bun run test:integration && bun run test:e2e"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.953.0",
    "@heroicons/react": "^2.2.0",
    "@node-saml/node-saml": "^5.1.0",
    "@opennextjs/cloudflare": "^1.19.10",
    "@ssb/db": "file:./packages/db",
    "@supabase/supabase-js": "^2.88.0",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "date-fns-tz": "^3.2.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "iron-session": "^8.0.4",
    "jspdf": "^4.2.1",
    "next": "^16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "wrangler": "^4.55.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@snaplet/copycat": "^6.0.0",
    "@snaplet/seed": "^0.98.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "prettier": "3.7.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
